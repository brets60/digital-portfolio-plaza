# VITE_CONTACT_FORM_ENDPOINT=https://api.web3forms.com/submit
# VITE_CONTACT_ACCESS_KEY=your_access_key_here

# Optional: Google Analytics / Plausible Analytics
# VITE_ANALYTICS_ID=G-XXXXXXXXXX

# Developer Contact Fallback
VITE_CONTACT_EMAIL=tristandaveplaza@example.com
VITE_SITE_URL=https://tristandaveplaza.dev
